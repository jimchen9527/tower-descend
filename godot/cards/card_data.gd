## Static definition of a single card.
##
## This is DATA, not behaviour: a [CardData] describes what a card *is*, while
## [CardEffect] decides what it *does*. A card is a **list of [CardEffectStep]**,
## not a single effect — that is what lets 「拆解」 (damage + block) and 「震波」
## (damage all enemies + block) exist as authored data instead of code.
##
## ## Why the previous single-effect fields are gone
## The earlier version had `effect_kind` + `damage`/`block`/`energy`, which can
## express exactly one thing per card. Every one of the 47 Web-build cards with
## a second effect, a condition or a multiplier had to be excluded because of
## it. Keeping those fields alongside [member effects] would leave two ways to
## say the same thing, and the resolution engine would have to guess which one
## was authoritative — a class of bug that only shows up on the card where they
## disagree. So the fields are deleted rather than deprecated.
##
## ## Upgrades
## Each step carries its own upgraded numbers and the card carries one
## [member upgraded] flag, so a card cannot be half-upgraded. See
## [method CardEffectStep.value_at] for the "0 means unchanged" convention.
class_name CardData
extends Resource

enum Rarity {
	BASIC,     ## Always in the starting deck.
	COMMON,    ## Common drop.
	UNCOMMON,  ## Uncommon drop.
	RARE,      ## Rare drop.
	CURSE,     ## Never a drop; only arrives as a penalty.
}

## Presentation class. Kept for filtering and for the card frame colour — the
## engine resolves on [enum CardEffectStep.EffectKind], never on this, because
## 「震波」 is an ATTACK that grants block.
enum CardType {
	ATTACK,
	SKILL,
	POWER,   ## Resolved when played, then exhausted for the combat.
	STATUS,  ## Generated by the game, never a drop.
}

## The three Web-build classes. Reused verbatim so card ids stay portable
## between the two codebases.
enum Discipline {
	DIGGER,    ## 掘者 — damage/impact axis.
	KEEPER,    ## 看护 — defence/block axis.
	MEDIC,     ## 医师 — sustain/status axis.
}

@export_group("Identity")

## Stable lookup key. Lower snake_case, globally unique, never shown to players.
## Mirrors the Web build's `id` so the same card is named identically in both.
@export var id: String = ""
## Player-facing name.
@export var title: String = ""
## Rules text, authored rather than generated. The Web build builds it from a
## `text(v)` function; doing the same in GDScript would mean the templating
## engine is a second source of truth for every number on the card.
@export_multiline var description: String = ""

@export_group("Cost")

## Energy required to play. 0 means free.
@export_range(0, 9, 1) var cost: int = 1

@export_group("Classification")

@export var card_type: CardType = CardType.ATTACK
@export var rarity: Rarity = Rarity.COMMON
@export var discipline: Discipline = Discipline.DIGGER
## Unlock depth (Web build's `dl`). 0 means "in the starting deck".
@export_range(0, 20, 1) var unlock_depth: int = 0

@export_group("Resolution")

## The steps this card performs, in order. Order is load-bearing: 「钢板护体」
## grants 敏捷 before granting block so its own block benefits, and `resolve`
## walks this array front to back.
@export var effects: Array[CardEffectStep] = []

## Whether this card is currently upgraded. One flag for the whole card so no
## step can be left reading base numbers after an upgrade.
@export var upgraded: bool = false

## Health lost every turn while this card sits in hand. Web build's
## `curseHpLoss` on 「疫尘入肺」. 0 for every normal card.
@export_range(0, 99, 1) var curse_hp_loss: int = 0

## Optional art. Left unset in the prototype so cards render from their title.
@export var icon: Texture2D


## Whether any step acts on an enemy. A card that is purely self-targeted
## (block, heal, energy) can be played with nothing adjacent, which is the
## whole reason this is asked of the data rather than of the caller.
func needs_target() -> bool:
	for step in effects:
		if step.needs_target():
			return true
	return false


## Whether the engine can resolve this card at all.
##
## A card with no steps is refused rather than played as a no-op: silently
## spending energy on nothing is worse than not offering the card. Curse cards
## are the deliberate exception — they are *meant* to be unplayable, and
## [member curse_hp_loss] is their whole effect.
func is_playable() -> bool:
	if not effects.is_empty():
		return true
	return curse_hp_loss > 0


## The number a card frame should headline, and its unit.
##
## Picks the first step that produces a player-facing number, skipping the
## internal ones: a card whose first step is DRAW should headline the damage it
## enables, not "2 抽牌". Returns (0, "") when nothing numeric is worth showing.
func headline() -> Array:
	for step in effects:
		if step.kind == CardEffectStep.EffectKind.DRAW:
			continue
		return [step.value_at(upgraded), step.unit_label()]
	return [0, ""]


func headline_value() -> int:
	return headline()[0]


func headline_unit() -> String:
	return headline()[1]


## Whether this card can be upgraded. The Web build marks an un-upgradable card
## with `upV: null`, which here means no step declares any upgraded number that
## differs from its base one.
func can_upgrade() -> bool:
	for step in effects:
		if step.value_at(true) != step.value_at(false):
			return true
		if step.condition_value_at(true) != step.condition_value_at(false):
			return true
		if step.ratio_at(true) != step.ratio_at(false):
			return true
		if step.per_at(true) != step.per_at(false):
			return true
		if step.scale_coef_at(true) != step.scale_coef_at(false):
			return true
	return false


## Developer-facing validation, called by [CardLibrary] when loading.
## [param source] is the card's path, used only in the message.
## Returns an empty string when the card is valid.
func validate(source: String) -> String:
	if id.is_empty():
		return "%s: id must not be empty" % source
	if title.is_empty():
		return "%s ('%s'): title must not be empty" % [source, id]
	if cost < 0:
		return "%s ('%s'): cost must not be negative" % [source, id]
	if curse_hp_loss < 0:
		return "%s ('%s'): curse_hp_loss must not be negative" % [source, id]

	# An empty card is only legal when it is a curse: a card with neither steps
	# nor a curse penalty is a content mistake, not a design.
	if effects.is_empty():
		if curse_hp_loss > 0:
			return ""
		return ("%s ('%s'): no effects and no curse_hp_loss — the card would do "
			+ "nothing at all") % [source, id]

	for step in effects:
		var reason := step.validate("%s ('%s')" % [source, id], upgraded)
		if not reason.is_empty():
			return reason
	return ""